semilogy(cumul_errors(2, :), 'LineWidth', 2);
semilogy(cumul_errors(3, :), 'LineWidth', 2);
%plot(x, modelFun(params, x), 'b-', 'LineWidth', 2, 'DisplayName', 'Fitted Curve');
grid on;
title("Variance of each parameters");
xlabel("n° iteration");
ylabel("Variance")
%xlim([10 length(error_iter)]);
legend("Param 1", "Param 2", "Param 3");

figure;
semilogy(iter_mat, cumul_var, '.','LineWidth',0.2); hold on;
%plot(x, modelFun(params, x), 'b-', 'LineWidth', 2, 'DisplayName', 'Fitted Curve');
grid on;
title("Variance of each parameters");
xlabel("n° iteration");
ylabel("Variance")
%xlim([10 length(error_iter)]);
legend("Param 1", "Param 2", "Param 3");